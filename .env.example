# Copy this file to .env.local and fill in your values.
# All NEXT_PUBLIC_ vars are inlined at build time — safe to use in browser.

# Identity
NEXT_PUBLIC_HOMESTAY_NAME="Aama Homestay"
NEXT_PUBLIC_HOMESTAY_TAGLINE="Your home in the hills"
NEXT_PUBLIC_HOMESTAY_LOCATION="Kurseong, West Bengal"
NEXT_PUBLIC_HOMESTAY_ADDRESS="Sudhapatole, Kurseong, West Bengal 734203"

# Contact
NEXT_PUBLIC_PHONE="+91 95601 28096"
NEXT_PUBLIC_WHATSAPP_NUMBER="919560128096"

# Timings
NEXT_PUBLIC_CHECKIN="2:00 PM"
NEXT_PUBLIC_CHECKOUT="12:00 PM"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?..."
NEXT_PUBLIC_GOOGLE_MAPS_URL="https://maps.google.com/?q=Aama+Homestay+Kurseong"

# Ratings
NEXT_PUBLIC_GOOGLE_RATING="4.7"
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT="352"

# Geo (for JSON-LD schema)
NEXT_PUBLIC_GEO_LAT="26.88685"
NEXT_PUBLIC_GEO_LNG="88.277344"
